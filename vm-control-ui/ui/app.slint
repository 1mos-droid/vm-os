import { ScrollView } from "std-widgets.slint";
import {
    Theme, Backdrop, Card, Separator, LargeTitle, Title, Headline, Body, Caption, SectionTitle,
    PushButton, IconButton, Chip, StatusDot, Switch, Segmented, Meter, Field, RangeSlider,
    Tile, ListGroup, ListRow, OptionCard, Toast, Sheet, Icon,
} from "strata.slint";

export { Theme }

export struct VmItem {
    vm-id: string,
    short-id: string,
    name: string,
    base-image-id: string,
    vcpu-count: int,
    ram-mib: int,
    balloon-target-mib: int,
    network-mode: string,
    network-plain-label: string,
    display-mode-label: string,
    state: string,
    disposable: bool,
    desired-min-ram-mib: int,
    accent: color,
    checkpoint-count: int,
    capture-supported: bool,
    capture-active: bool,
    capture-status-label: string,
}

export struct CheckpointItem {
    snapshot-id: string,
    short-snap-id: string,
    vm-id: string,
    vm-name: string,
    label: string,
    created-at: string,
    vm-stopped: bool,
}

export struct CaptureItem {
    capture-id: string,
    short-capture-id: string,
    vm-id: string,
    vm-name: string,
    started-at: string,
    state: string,
    bytes-label: string,
    pcap-hint: string,
}

export struct TemplateItem {
    image-id: string,
    label: string,
    description: string,
    recommended-min-ram-mib: int,
    recommended-max-ram-mib: int,
    recommended-vcpus: int,
}

export struct StoreCardItem {
    image-id: string,
    title: string,
    summary: string,
    download-label: string,
    status-label: string,
    progress-ratio: float,
    progress-pct: int,
    installed: bool,
    busy: bool,
}

export component MainWindow inherits Window {
    title: "VM Studio — HyperOS";
    preferred-width: 1100px;
    preferred-height: 780px;
    min-width: 880px;
    min-height: 620px;
    default-font-family: Theme.ui-font-family;
    default-font-size: Theme.font-base;
    background: Theme.window-bg;

    // Navigation: 0 = Spaces, 1 = Create Space, 2 = Template Store, 3 = Guided Settings
    in-out property <int> active-tab: 0;
    in property <string> backend-label: "/run/hyperos/vmm.sock";
    in property <bool> backend-connected: false;
    in property <bool> mock-mode: false;

    // Host memory & ZRAM telemetry
    in property <float> ram-usage-ratio: 0.0;
    in property <string> ram-summary: "0 / 0 MiB";
    in property <string> ram-detail: "Available: 0 MiB";
    in property <float> zram-usage-ratio: 0.0;
    in property <string> zram-summary: "Unavailable";
    in property <string> zram-detail: "No /sys/block/zram0/mm_stat";

    // Spaces, Visual Checkpoints & Packet Captures
    in property <[VmItem]> vms: [];
    in property <[CheckpointItem]> checkpoints: [];
    in property <[CaptureItem]> captures: [];
    in property <string> status-message: "";
    in property <bool> status-is-error: false;

    // Hard power-off confirmation modal (ARCHITECTURE.md: stop_vm is hard power-off)
    in-out property <bool> confirm-stop-visible: false;
    in-out property <string> confirm-stop-vm-id: "";
    in-out property <string> confirm-stop-vm-name: "";
    in-out property <bool> confirm-stop-vm-disposable: false;

    // Snapshot restore confirmation modal (Contract v2: overwrites current/ disk)
    in-out property <bool> confirm-restore-visible: false;
    in-out property <string> confirm-restore-vm-id: "";
    in-out property <string> confirm-restore-vm-name: "";
    in-out property <string> confirm-restore-snap-id: "";
    in-out property <string> confirm-restore-snap-label: "";

    // Plain-English Create Space Flow state
    in property <[TemplateItem]> templates: [];
    in-out property <int> wizard-template-index: 0;
    in-out property <string> wizard-name: "";
    in-out property <int> wizard-memory-profile: 1; // 0=Light, 1=Standard, 2=Heavy
    in-out property <int> wizard-max-ram-mib: 1024;
    in-out property <int> wizard-min-ram-mib: 512;
    in-out property <int> wizard-vcpu-count: 2;
    in property <int> max-host-cpus: 4;
    in-out property <int> wizard-network-mode: 0; // 0=Isolated, 1=NAT Internet Only, 2=Host-Only
    in-out property <int> wizard-display-mode: 0; // 0=Seamless App Window, 1=Full Environment
    in-out property <bool> wizard-disposable: false;

    // Template Store state
    in property <[StoreCardItem]> store-cards: [];

    // Guided Settings & Btrfs CoW Storage Savings state
    in-out property <bool> settings-wifi-enabled: true;
    in property <string> settings-wifi-name: "Home-5G";
    in-out property <bool> settings-airplane-isolation: false;
    in-out property <int> settings-sound-volume: 75;
    in-out property <bool> settings-sound-muted: false;
    in-out property <bool> settings-guest-audio: true;
    in-out property <int> settings-display-scale: 100;
    in-out property <bool> settings-smooth-transitions: true;
    in property <string> cow-headline: "0.0 GiB saved via Btrfs Copy-on-Write";
    in property <string> cow-detail: "0 Spaces sharing 0 immutable base images";
    in property <float> cow-savings-ratio: 0.0;

    // Callbacks wired in Rust
    callback refresh-requested();
    callback reclaim-ram-requested();
    callback start-vm(string);
    callback pause-vm(string);
    callback snapshot-vm(string);
    callback confirm-restore-snapshot(string, string);
    callback delete-snapshot(string, string);
    callback start-capture(string);
    callback stop-capture(string);
    callback delete-capture(string, string);
    callback confirm-stop-vm(string);
    callback adjust-balloon-ram(string, int);
    callback change-network-mode(string, string);
    callback select-template(int);
    callback select-memory-profile(int);
    callback create-vm-submitted();
    callback download-store-template(string);
    callback use-store-template(string);
    callback settings-changed();

    property <string> page-title:
        root.active-tab == 0 ? "Spaces" :
        root.active-tab == 1 ? "New Space" :
        root.active-tab == 2 ? "Templates" : "Settings";
    property <string> page-subtitle:
        root.active-tab == 0 ? "Each Space is its own hardware-isolated virtual machine." :
        root.active-tab == 1 ? "Pick what this Space is for. HyperOS sets up the disk, memory and network." :
        root.active-tab == 2 ? "Verified base images that new Spaces start from. Downloads are checked against their SHA-256." :
        "Preferences for this computer.";

    Backdrop { intensity: 0.55; }

    HorizontalLayout {
        // ================= SIDEBAR =================
        Rectangle {
            width: 232px;
            background: Theme.bar-glass;

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.separator;
            }

            VerticalLayout {
                padding: 14px;
                padding-top: 18px;
                spacing: 4px;

                // Brand
                HorizontalLayout {
                    padding-left: 6px;
                    padding-bottom: 16px;
                    spacing: 10px;
                    Tile {
                        icon: "grid";
                        tint: Theme.accent;
                        tile-size: 30px;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;
                        Text {
                            text: "VM Studio";
                            color: Theme.text-primary;
                            font-size: Theme.size-headline;
                            font-weight: 700;
                        }
                        Text {
                            text: "HyperOS";
                            color: Theme.text-muted;
                            font-size: Theme.size-caption;
                        }
                    }
                }

                for nav[i] in [
                    { label: "Spaces", icon: "grid" },
                    { label: "New Space", icon: "plus" },
                    { label: "Templates", icon: "package" },
                    { label: "Settings", icon: "sliders" },
                ] : Rectangle {
                    height: 36px;
                    border-radius: Theme.radius-sm;
                    background: root.active-tab == i ? Theme.accent-soft : nav-ta.has-hover ? Theme.fill-hover : transparent;
                    animate background { duration: 120ms; }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        Icon {
                            name: nav.icon;
                            size: 17px;
                            color: root.active-tab == i ? Theme.accent : Theme.text-secondary;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: nav.label;
                            color: root.active-tab == i ? Theme.text-primary : Theme.text-secondary;
                            font-size: Theme.size-body;
                            font-weight: root.active-tab == i ? 600 : 500;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if i == 0 && root.vms.length > 0 : Text {
                            text: root.vms.length;
                            color: Theme.text-muted;
                            font-size: Theme.size-footnote;
                            vertical-alignment: center;
                        }
                    }
                    nav-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.active-tab = i; }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // Host memory
                Card {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            SectionTitle { text: "MEMORY"; horizontal-stretch: 1; }
                            Text {
                                text: root.ram-summary;
                                color: Theme.text-secondary;
                                font-size: Theme.size-caption;
                                font-weight: 500;
                            }
                        }
                        Meter {
                            ratio: root.ram-usage-ratio;
                            fill: root.ram-usage-ratio > 0.85 ? Theme.danger : root.ram-usage-ratio > 0.65 ? Theme.warning : Theme.accent;
                        }
                        HorizontalLayout {
                            SectionTitle { text: "ZRAM"; horizontal-stretch: 1; }
                            Text {
                                text: root.zram-summary;
                                color: Theme.text-secondary;
                                font-size: Theme.size-caption;
                                font-weight: 500;
                            }
                        }
                        Meter {
                            ratio: root.zram-usage-ratio;
                            fill: Theme.info;
                        }
                        PushButton {
                            text: "Reclaim memory";
                            icon: "bolt";
                            kind: "secondary";
                            small: true;
                            horizontal-stretch: 1;
                            clicked => { root.reclaim-ram-requested(); }
                        }
                    }
                }

                // Connection
                HorizontalLayout {
                    padding-top: 8px;
                    padding-left: 6px;
                    spacing: 8px;
                    StatusDot {
                        dot-color: root.backend-connected ? Theme.success : Theme.danger;
                    }
                    Text {
                        text: root.mock-mode ? "Demo data" : root.backend-connected ? "Connected" : "Not connected";
                        color: Theme.text-muted;
                        font-size: Theme.size-caption;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.mock-mode : Chip { text: "Mock"; tone: "info"; }
                }
            }
        }

        // ================= CONTENT =================
        VerticalLayout {
            horizontal-stretch: 1;

            // Header bar
            HorizontalLayout {
                padding-left: 32px;
                padding-right: 24px;
                padding-top: 22px;
                padding-bottom: 14px;
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    LargeTitle { text: root.page-title; }
                    Caption { text: root.page-subtitle; }
                }
                IconButton {
                    icon: "refresh";
                    clicked => { root.refresh-requested(); }
                }
                if root.active-tab == 0 : PushButton {
                    text: "New Space";
                    icon: "plus";
                    kind: "primary";
                    clicked => { root.active-tab = 1; }
                }
            }

            // ---------- Spaces ----------
            if root.active-tab == 0 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding-left: 32px;
                    padding-right: 28px;
                    padding-bottom: 32px;
                    spacing: 12px;
                    alignment: start;

                    if root.vms.length == 0 : Card {
                        height: 220px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 10px;
                            HorizontalLayout {
                                alignment: center;
                                Tile { icon: "sparkle"; tile-size: 52px; }
                            }
                            Text {
                                text: "No Spaces yet";
                                color: Theme.text-primary;
                                font-size: Theme.size-title3;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "A Space is a disposable or persistent VM for one job.";
                                color: Theme.text-muted;
                                font-size: Theme.size-body;
                                horizontal-alignment: center;
                            }
                            HorizontalLayout {
                                alignment: center;
                                PushButton {
                                    text: "Create your first Space";
                                    kind: "primary";
                                    clicked => { root.active-tab = 1; }
                                }
                            }
                        }
                    }

                    for vm in root.vms : Card {
                        VerticalLayout {
                            padding: 16px;
                            padding-left: 18px;
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 14px;

                                Tile {
                                    icon: vm.network-mode == "nat" ? "globe" : vm.network-mode == "host-only" ? "home" : "lock";
                                    tint: vm.accent;
                                    tile-size: 44px;
                                    badge: vm.disposable ? "hourglass" : "";
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Headline {
                                            text: vm.name;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Chip {
                                            text: vm.state == "running" ? "Running" : vm.state == "paused" ? "Paused" : vm.state == "failed" ? "Failed" : "Stopped";
                                            tone: vm.state == "running" ? "success" : vm.state == "paused" ? "warning" : vm.state == "failed" ? "danger" : "neutral";
                                            dot: true;
                                        }
                                        if vm.capture-active : Chip {
                                            text: "Recording";
                                            tone: "danger";
                                            icon: "record";
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    Text {
                                        text: vm.base-image-id + "  ·  " + vm.vcpu-count + " vCPU  ·  " + vm.balloon-target-mib + " / " + vm.ram-mib + " MiB";
                                        color: Theme.text-muted;
                                        font-size: Theme.size-footnote;
                                        overflow: elide;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: end;
                                    IconButton {
                                        icon: "camera";
                                        enabled: vm.state == "stopped" && !vm.disposable;
                                        clicked => { root.snapshot-vm(vm.vm-id); }
                                    }
                                    IconButton {
                                        icon: "record";
                                        active: vm.capture-active;
                                        tint: vm.capture-active ? Theme.danger : Theme.text-secondary;
                                        enabled: vm.capture-active || (vm.state == "running" && vm.capture-supported);
                                        clicked => {
                                            if (vm.capture-active) {
                                                root.stop-capture(vm.vm-id);
                                            } else {
                                                root.start-capture(vm.vm-id);
                                            }
                                        }
                                    }
                                    if vm.state == "running" : IconButton {
                                        icon: "pause";
                                        clicked => { root.pause-vm(vm.vm-id); }
                                    }
                                    if vm.state == "running" || vm.state == "paused" : PushButton {
                                        text: "Stop";
                                        icon: "power";
                                        kind: "danger";
                                        clicked => {
                                            root.confirm-stop-vm-id = vm.vm-id;
                                            root.confirm-stop-vm-name = vm.name;
                                            root.confirm-stop-vm-disposable = vm.disposable;
                                            root.confirm-stop-visible = true;
                                        }
                                    }
                                    if vm.state != "running" : PushButton {
                                        text: vm.state == "paused" ? "Resume" : "Start";
                                        icon: "play";
                                        kind: "primary";
                                        clicked => { root.start-vm(vm.vm-id); }
                                    }
                                }
                            }

                            Separator {}

                            HorizontalLayout {
                                spacing: 6px;
                                Chip {
                                    text: vm.network-plain-label;
                                    icon: vm.network-mode == "nat" ? "globe" : vm.network-mode == "host-only" ? "home" : "lock";
                                    tone: vm.network-mode == "nat" ? "accent" : vm.network-mode == "host-only" ? "info" : "neutral";
                                }
                                Chip {
                                    text: vm.display-mode-label;
                                    icon: "window";
                                }
                                if vm.disposable : Chip {
                                    text: "Disposable";
                                    icon: "hourglass";
                                    tone: "warning";
                                }
                                if !vm.disposable && vm.checkpoint-count > 0 : Chip {
                                    text: vm.checkpoint-count == 1 ? "1 snapshot" : vm.checkpoint-count + " snapshots";
                                    icon: "camera";
                                }
                                if vm.capture-supported && !vm.capture-active && vm.capture-status-label != "" : Chip {
                                    text: vm.capture-status-label;
                                    icon: "record";
                                }

                                Rectangle { horizontal-stretch: 1; }

                                if vm.state == "running" : HorizontalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 0;
                                    Caption {
                                        text: "Memory";
                                        vertical-alignment: center;
                                    }
                                    IconButton {
                                        icon: "minus";
                                        button-size: 28px;
                                        enabled: vm.balloon-target-mib > 128;
                                        clicked => { root.adjust-balloon-ram(vm.vm-id, Math.max(128, vm.balloon-target-mib - 128)); }
                                    }
                                    Text {
                                        text: vm.balloon-target-mib + " MiB";
                                        color: Theme.text-primary;
                                        font-size: Theme.size-footnote;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        min-width: 64px;
                                        horizontal-alignment: center;
                                    }
                                    IconButton {
                                        icon: "plus";
                                        button-size: 28px;
                                        enabled: vm.balloon-target-mib < vm.ram-mib;
                                        clicked => { root.adjust-balloon-ram(vm.vm-id, Math.min(vm.ram-mib, vm.balloon-target-mib + 128)); }
                                    }
                                    if vm.desired-min-ram-mib >= 128 && vm.desired-min-ram-mib < vm.ram-mib && vm.balloon-target-mib != vm.desired-min-ram-mib : PushButton {
                                        text: "Fit " + vm.desired-min-ram-mib;
                                        kind: "ghost";
                                        small: true;
                                        clicked => { root.adjust-balloon-ram(vm.vm-id, vm.desired-min-ram-mib); }
                                    }
                                }

                                if vm.state == "stopped" : Segmented {
                                    small: true;
                                    width: 228px;
                                    items: ["Offline", "Internet", "Local"];
                                    current: vm.network-mode == "nat" ? 1 : vm.network-mode == "host-only" ? 2 : 0;
                                    activated(i) => {
                                        root.change-network-mode(vm.vm-id, i == 1 ? "nat" : i == 2 ? "host-only" : "isolated");
                                    }
                                }
                            }
                        }
                    }

                    if root.checkpoints.length > 0 : VerticalLayout {
                        padding-top: 14px;
                        spacing: 8px;
                        SectionTitle { text: "SNAPSHOTS"; }
                        ListGroup {
                            for cp[ci] in root.checkpoints : ListRow {
                                title: cp.vm-name + " — " + cp.label;
                                subtitle: cp.created-at + "  ·  " + cp.short-snap-id + (cp.vm-stopped ? "" : "  ·  stop the Space to restore");
                                icon: "camera";
                                icon-tint: Theme.info;
                                last: ci == root.checkpoints.length - 1;
                                PushButton {
                                    text: "Restore";
                                    icon: "restore";
                                    small: true;
                                    enabled: cp.vm-stopped;
                                    clicked => {
                                        root.confirm-restore-vm-id = cp.vm-id;
                                        root.confirm-restore-vm-name = cp.vm-name;
                                        root.confirm-restore-snap-id = cp.snapshot-id;
                                        root.confirm-restore-snap-label = cp.label;
                                        root.confirm-restore-visible = true;
                                    }
                                }
                                IconButton {
                                    icon: "trash";
                                    tint: Theme.danger;
                                    clicked => { root.delete-snapshot(cp.vm-id, cp.snapshot-id); }
                                }
                            }
                        }
                    }

                    if root.captures.length > 0 : VerticalLayout {
                        padding-top: 14px;
                        spacing: 8px;
                        SectionTitle { text: "PACKET CAPTURES"; }
                        ListGroup {
                            for cap[ki] in root.captures : ListRow {
                                title: cap.vm-name + " — capture " + cap.short-capture-id;
                                subtitle: cap.started-at + "  ·  " + cap.pcap-hint;
                                mono-subtitle: true;
                                icon: "record";
                                icon-tint: cap.state == "running" ? Theme.danger : Theme.text-muted;
                                last: ki == root.captures.length - 1;
                                Chip {
                                    text: cap.state == "running" ? "Recording" : cap.state == "limit_reached" ? "Size limit" : "Saved";
                                    tone: cap.state == "running" ? "danger" : cap.state == "limit_reached" ? "warning" : "success";
                                    dot: true;
                                }
                                Chip {
                                    text: cap.bytes-label;
                                }
                                IconButton {
                                    icon: "trash";
                                    tint: Theme.danger;
                                    enabled: cap.state != "running";
                                    clicked => { root.delete-capture(cap.vm-id, cap.capture-id); }
                                }
                            }
                        }
                    }
                }
            }

            // ---------- New Space ----------
            if root.active-tab == 1 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding-left: 32px;
                    padding-right: 28px;
                    padding-bottom: 32px;
                    spacing: 22px;
                    alignment: start;

                    VerticalLayout {
                        spacing: 8px;
                        SectionTitle { text: "NAME"; }
                        Field {
                            placeholder: "e.g. Malware lab, Banking, Travel browser";
                            text <=> root.wizard-name;
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        SectionTitle { text: "START FROM"; }
                        HorizontalLayout {
                            spacing: 10px;
                            for tpl[idx] in root.templates : OptionCard {
                                title: tpl.label;
                                description: tpl.description;
                                icon: "package";
                                tint: Theme.accent;
                                selected: root.wizard-template-index == idx;
                                clicked => { root.select-template(idx); }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        SectionTitle { text: "NETWORK"; }
                        HorizontalLayout {
                            spacing: 10px;
                            OptionCard {
                                title: "Offline";
                                description: "No network at all. For private files, keys and detonating samples.";
                                icon: "lock";
                                tint: Theme.warning;
                                selected: root.wizard-network-mode == 0;
                                clicked => { root.wizard-network-mode = 0; }
                            }
                            OptionCard {
                                title: "Internet only";
                                description: "Reaches the public internet. Your LAN, this computer and other Spaces stay blocked.";
                                icon: "globe";
                                tint: Theme.accent;
                                selected: root.wizard-network-mode == 1;
                                clicked => { root.wizard-network-mode = 1; }
                            }
                            OptionCard {
                                title: "This computer only";
                                description: "A private link to the host. No internet.";
                                icon: "home";
                                tint: Theme.info;
                                selected: root.wizard-network-mode == 2;
                                clicked => { root.wizard-network-mode = 2; }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        SectionTitle { text: "MEMORY"; }
                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;
                                Segmented {
                                    items: ["Light", "Standard", "Heavy"];
                                    current <=> root.wizard-memory-profile;
                                    activated(i) => { root.select-memory-profile(i); }
                                }
                                HorizontalLayout {
                                    Body {
                                        text: root.wizard-memory-profile == 0 ? "Notes, vaults and small tools." : root.wizard-memory-profile == 1 ? "Browsing, office and everyday apps." : "Media, coding and large workloads.";
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: root.wizard-min-ram-mib + " – " + root.wizard-max-ram-mib + " MiB  ·  " + root.wizard-vcpu-count + " vCPU";
                                        color: Theme.text-primary;
                                        font-size: Theme.size-footnote;
                                        font-weight: 600;
                                    }
                                }
                                RangeSlider {
                                    minimum: 128;
                                    maximum: 3072;
                                    value: root.wizard-max-ram-mib;
                                    changed(val) => {
                                        root.wizard-max-ram-mib = Math.clamp(Math.round(val / 64) * 64, 128, 3072);
                                        if (root.wizard-min-ram-mib > root.wizard-max-ram-mib) {
                                            root.wizard-min-ram-mib = root.wizard-max-ram-mib;
                                        }
                                    }
                                }
                                Caption { text: "The slider sets the most memory this Space may ever use. When idle it shrinks back automatically."; wrap: word-wrap; }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        SectionTitle { text: "BEHAVIOUR"; }
                        ListGroup {
                            ListRow {
                                title: "Window style";
                                subtitle: root.wizard-display-mode == 0 ? "Apps appear on your desktop, edged in this Space's colour." : "Opens as a separate full desktop.";
                                icon: "window";
                                Segmented {
                                    small: true;
                                    width: 240px;
                                    items: ["App windows", "Full desktop"];
                                    current <=> root.wizard-display-mode;
                                }
                            }
                            ListRow {
                                title: "Disposable";
                                subtitle: "Throw away every change when the Space stops or crashes. Snapshots are turned off.";
                                icon: "hourglass";
                                icon-tint: Theme.warning;
                                last: true;
                                Switch {
                                    checked <=> root.wizard-disposable;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        PushButton {
                            text: "Cancel";
                            kind: "ghost";
                            clicked => { root.active-tab = 0; }
                        }
                        PushButton {
                            text: "Create Space";
                            kind: "primary";
                            clicked => { root.create-vm-submitted(); }
                        }
                    }
                }
            }

            // ---------- Templates ----------
            if root.active-tab == 2 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding-left: 32px;
                    padding-right: 28px;
                    padding-bottom: 32px;
                    spacing: 12px;
                    alignment: start;

                    for card in root.store-cards : Card {
                        HorizontalLayout {
                            padding: 16px;
                            spacing: 14px;
                            Tile {
                                icon: "package";
                                tint: card.installed ? Theme.success : Theme.accent;
                                tile-size: 44px;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Headline { text: card.title; vertical-alignment: center; }
                                    Chip {
                                        text: card.status-label;
                                        tone: card.installed ? "success" : card.busy ? "accent" : "neutral";
                                        dot: true;
                                    }
                                    Chip { text: card.download-label; }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Body { text: card.summary; }
                                if card.busy : Meter {
                                    ratio: card.progress-ratio;
                                    fill: Theme.accent;
                                }
                            }
                            if !card.installed : PushButton {
                                text: card.busy ? card.progress-pct + "%" : "Get";
                                icon: card.busy ? "" : "plus";
                                kind: "secondary";
                                enabled: !card.busy;
                                clicked => { root.download-store-template(card.image-id); }
                            }
                            if card.installed : PushButton {
                                text: "New Space";
                                kind: "primary";
                                clicked => { root.use-store-template(card.image-id); }
                            }
                        }
                    }
                }
            }

            // ---------- Settings ----------
            if root.active-tab == 3 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding-left: 32px;
                    padding-right: 28px;
                    padding-bottom: 32px;
                    spacing: 8px;
                    alignment: start;

                    SectionTitle { text: "NETWORK"; }
                    ListGroup {
                        ListRow {
                            title: "Wi-Fi";
                            subtitle: root.settings-airplane-isolation ? "Off while Airplane isolation is on" : root.settings-wifi-enabled ? root.settings-wifi-name : "Off";
                            icon: root.settings-wifi-enabled ? "wifi" : "wifi-off";
                            Switch {
                                checked <=> root.settings-wifi-enabled;
                                toggled => { root.settings-changed(); }
                            }
                        }
                        ListRow {
                            title: "Airplane isolation";
                            subtitle: "Cut every uplink for all Spaces at once";
                            icon: "shield";
                            icon-tint: Theme.warning;
                            last: true;
                            Switch {
                                checked <=> root.settings-airplane-isolation;
                                toggled => { root.settings-changed(); }
                            }
                        }
                    }

                    Rectangle { height: 12px; }
                    SectionTitle { text: "SOUND"; }
                    ListGroup {
                        ListRow {
                            title: "Volume";
                            subtitle: root.settings-sound-muted ? "Muted" : root.settings-sound-volume + "%";
                            icon: root.settings-sound-muted ? "volume-off" : "volume";
                            RangeSlider {
                                width: 220px;
                                minimum: 0;
                                maximum: 100;
                                value: root.settings-sound-volume;
                                changed(v) => {
                                    root.settings-sound-volume = Math.round(v);
                                    root.settings-changed();
                                }
                            }
                        }
                        ListRow {
                            title: "Mute";
                            icon: "volume-off";
                            icon-tint: Theme.text-muted;
                            Switch {
                                checked <=> root.settings-sound-muted;
                                toggled => { root.settings-changed(); }
                            }
                        }
                        ListRow {
                            title: "Sound from Spaces";
                            subtitle: "Play guest audio through this computer";
                            icon: "volume";
                            icon-tint: Theme.info;
                            last: true;
                            Switch {
                                checked <=> root.settings-guest-audio;
                                toggled => { root.settings-changed(); }
                            }
                        }
                    }

                    Rectangle { height: 12px; }
                    SectionTitle { text: "DISPLAY"; }
                    ListGroup {
                        ListRow {
                            title: "Scale";
                            icon: "monitor";
                            Segmented {
                                small: true;
                                width: 220px;
                                items: ["100%", "125%", "150%"];
                                current: root.settings-display-scale == 150 ? 2 : root.settings-display-scale == 125 ? 1 : 0;
                                activated(i) => {
                                    root.settings-display-scale = i == 2 ? 150 : i == 1 ? 125 : 100;
                                    root.settings-changed();
                                }
                            }
                        }
                        ListRow {
                            title: "Smooth window animations";
                            icon: "sparkle";
                            last: true;
                            Switch {
                                checked <=> root.settings-smooth-transitions;
                                toggled => { root.settings-changed(); }
                            }
                        }
                    }

                    Rectangle { height: 12px; }
                    SectionTitle { text: "STORAGE"; }
                    Card {
                        HorizontalLayout {
                            padding: 16px;
                            spacing: 14px;
                            Tile {
                                icon: "disk";
                                tint: Theme.success;
                                tile-size: 40px;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 8px;
                                Headline { text: root.cow-headline; }
                                Meter {
                                    ratio: root.cow-savings-ratio;
                                    fill: Theme.success;
                                }
                                Caption { text: root.cow-detail; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
        }
    }

    // ================= Toast =================
    // Success messages fade after 4 s; errors stay until dismissed.
    property <bool> toast-dismissed: false;
    changed status-message => { root.toast-dismissed = false; }
    Timer {
        interval: 4s;
        running: root.status-message != "" && !root.status-is-error && !root.toast-dismissed;
        triggered => { root.toast-dismissed = true; }
    }
    if root.status-message != "" && !root.toast-dismissed : Toast {
        dismissed => { root.toast-dismissed = true; }
        text: root.status-message;
        error: root.status-is-error;
        width: Math.min(560px, parent.width - 320px);
        x: 232px + (parent.width - 232px - self.width) / 2;
        y: parent.height - self.height - 20px;
    }

    // ================= Sheets =================
    if root.confirm-stop-visible : Sheet {
        width: parent.width;
        height: parent.height;
        title: "Stop “" + root.confirm-stop-vm-name + "”?";
        message: "This switches the Space off immediately, like pulling the plug. Anything unsaved inside it may be lost.";
        note: root.confirm-stop-vm-disposable ? "This Space is disposable: every change since it started will be erased." : "";
        icon: "power";
        tone: "danger";
        confirm-text: "Stop Space";
        confirm-kind: "danger-solid";
        cancelled => { root.confirm-stop-visible = false; }
        confirmed => {
            root.confirm-stop-visible = false;
            root.confirm-stop-vm(root.confirm-stop-vm-id);
        }
    }

    if root.confirm-restore-visible : Sheet {
        width: parent.width;
        height: parent.height;
        title: "Restore “" + root.confirm-restore-snap-label + "”?";
        message: "“" + root.confirm-restore-vm-name + "” goes back to how it was when this snapshot was taken. Changes made since then are lost.";
        icon: "restore";
        tone: "warning";
        confirm-text: "Restore";
        confirm-kind: "primary";
        cancelled => { root.confirm-restore-visible = false; }
        confirmed => {
            root.confirm-restore-visible = false;
            root.confirm-restore-snapshot(root.confirm-restore-vm-id, root.confirm-restore-snap-id);
        }
    }
}
