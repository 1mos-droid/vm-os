#!/bin/sh
set -eu
while [ ! -f /run/hyperos/ready/udev ] || [ ! -S /run/seatd.sock ] || [ ! -S /run/hyperos/vmm.sock ]; do sleep 1; done
export XDG_RUNTIME_DIR=/run/user/1000
export HOME=/home/desktop
export LIBSEAT_BACKEND=seatd
export SLINT_BACKEND=linuxkms-software
exec chpst -u desktop:hyperos:video /usr/bin/desktop-shell
