#!/bin/sh
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
set -eu
hostname hyperos
mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mkdir -p /run/hyperos/ready /run/runit /run/service /run/lock /dev/pts /dev/shm
touch /run/runit/stopit /run/runit/reboot
chmod 0000 /run/runit/stopit /run/runit/reboot
chmod 0700 /run/hyperos
mount -t devpts -o mode=0620,nosuid,noexec devpts /dev/pts
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp
for service in zram ksm storage vmm-daemon getty-tty1; do
    mkdir -p "/run/runit/$service"
    ln -s "/etc/sv/$service" "/run/service/$service"
done
