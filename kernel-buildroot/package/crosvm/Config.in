config BR2_PACKAGE_CROSVM
	bool "crosvm"
	depends on BR2_x86_64
	depends on BR2_USE_MMU
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_LIBCAP
	select BR2_PACKAGE_WAYLAND
	help
	  Build the pinned crosvm and minijail sources for musl, with
	  balloon, 2D GPU, TAP networking, and x86_64 seccomp policies.
	  Requires host Cargo/Rust (musl target), Python 3, and libclang.
