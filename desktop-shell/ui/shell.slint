import { ScrollView } from "std-widgets.slint";
import {
    Theme, Backdrop, Card, Separator, Title, Headline, Body, Caption, SectionTitle,
    PushButton, IconButton, Chip, Switch, Segmented, Meter, Field, Tile,
    ListGroup, ListRow, OptionCard, Toast, Sheet, Icon,
} from "strata.slint";

export { Theme }

export struct SpacePill {
    vm-id: string,
    name: string,
    ram-label: string,
    network-badge: string,
    disposable: bool,
    capturing: bool,
    accent: color,
    active: bool,
    running: bool,
}

export struct ShellSnapshotItem {
    snapshot-id: string,
    short-id: string,
    vm-id: string,
    created-at: string,
    can-restore: bool,
}

export struct ShellCaptureItem {
    capture-id: string,
    short-id: string,
    vm-id: string,
    started-at: string,
    state: string,
    bytes-label: string,
}

export struct ShellWindowCard {
    window-id: int,
    title: string,
    badge-label: string,
    accent: color,
    x: length,
    y: length,
    width: length,
    height: length,
    focused: bool,
    snap-label: string,
}

export struct DeckResultItem {
    entry-id: string,
    title: string,
    subtitle: string,
    category: string,
    accent: color,
}

export component HyperShellWindow inherits Window {
    title: "HyperOS";
    preferred-width: 1280px;
    preferred-height: 760px;
    min-width: 960px;
    min-height: 600px;
    default-font-family: Theme.ui-font-family;
    default-font-size: Theme.font-base;
    background: Theme.window-bg;

        in property <[SpacePill]> space-pills: [];
    in property <string> active-space-key: "host";
    in property <string> host-zram-label: "RAM 310 / 4096M · ZRAM 142M";
    in property <float> host-ram-ratio: 0.15;
    in property <string> wifi-label: "Wi-Fi";
    in property <bool> wifi-enabled: true;
    in property <string> audio-label: "Vol 72%";
    in property <bool> audio-muted: false;
    in property <string> battery-label: "84%";
    in property <int> display-scale-pct: 100;
    in property <bool> global-offline-shield: false;
    in property <string> rail-toast: "";
    in property <bool> vmm-connected: true;
    in property <string> vmm-error: "";

    // Compositor window surfaces (2px colored origin border + subtle origin badge)
    in property <[ShellWindowCard]> windows: [];

    // Super-key Action Deck overlay & Active Space Research Controls
    in-out property <bool> action-deck-visible: false;
    in-out property <string> deck-query: "";
    in-out property <bool> deck-launch-disposable: false;
    in property <[DeckResultItem]> deck-results: [];
    in property <string> selected-vm-id: "";
    in property <string> selected-vm-name: "";
    in property <string> selected-vm-state: "";
    in property <string> selected-vm-network-badge: "";
    in property <bool> selected-vm-disposable: false;
    in property <bool> selected-capture-supported: false;
    in property <bool> selected-capture-active: false;
    in property <string> selected-capture-status: "Capture Idle";
    in property <[ShellSnapshotItem]> selected-snapshots: [];
    in property <[ShellCaptureItem]> selected-captures: [];

    // Mandatory confirmation modals (hard power-off & snapshot restore overwrite)
    in-out property <bool> confirm-stop-visible: false;
    in-out property <string> confirm-stop-vm-id: "";
    in-out property <string> confirm-stop-vm-name: "";
    in-out property <bool> confirm-stop-vm-disposable: false;

    in-out property <bool> confirm-restore-visible: false;
    in-out property <string> confirm-restore-vm-id: "";
    in-out property <string> confirm-restore-vm-name: "";
    in-out property <string> confirm-restore-snap-id: "";
    in-out property <string> confirm-restore-short-id: "";

    // Callbacks wired in Rust (Smithay + VMM JSON-RPC bridge)
    callback toggle-action-deck();
    callback deck-query-changed(string);
    callback activate-space(string);
    callback new-space-clicked();
    callback reclaim-ram-clicked();
    callback launch-preset(string);
    callback activate-deck-entry(string);
    callback start-vm-action(string);
    callback confirm-stop-vm-action(string);
    callback snapshot-vm-action(string);
    callback confirm-restore-snapshot-action(string, string);
    callback delete-snapshot-action(string, string);
    callback start-capture-action(string);
    callback stop-capture-action(string);
    callback delete-capture-action(string, string);
    callback focus-window(int);
    callback snap-window-action(int, string);
    callback toggle-wifi();
    callback toggle-audio-mute();
    callback cycle-display-scale();
    callback toggle-offline-shield();

    // Geometry shared with desktop_shell::layout (TOP_RAIL_HEIGHT_PX / BOTTOM_DOCK_HEIGHT_PX).
    property <length> bar-h: 36px;
    property <length> dock-h: 84px;

    pure function net-icon(badge: string) -> string {
        if (badge == "NAT · Internet Only") { return "globe"; }
        if (badge == "Host-Only · Local") { return "home"; }
        return "lock";
    }

    // Global keyboard shortcut handler (Super / Escape)
    FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Meta || (event.text == "\u{001b}" && root.action-deck-visible)) {
                root.toggle-action-deck();
                return accept;
            }
            reject
        }

        // ================= DESKTOP =================
        Backdrop {
            width: 100%;
            height: 100%;
        }

        if root.windows.length == 0 : VerticalLayout {
            y: root.bar-h;
            height: parent.height - root.bar-h - root.dock-h;
            alignment: center;
            spacing: 10px;
            HorizontalLayout {
                alignment: center;
                Tile { icon: "grid"; tile-size: 56px; }
            }
            Text {
                text: "Your desktop is clear";
                color: Theme.text-primary;
                font-size: Theme.size-title2;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: "Press Super to search, or start a Space from the dock.";
                color: Theme.text-muted;
                font-size: Theme.size-body;
                horizontal-alignment: center;
            }
        }

        // ================= WINDOWS =================
        // Origin edges are drawn here by the host, so guests cannot spoof them.
        // Unfocused windows dim their edge so the active trust boundary stands out.
        for win in root.windows : Rectangle {
            x: win.x;
            y: win.y;
            width: win.width;
            height: win.height;
            border-radius: Theme.radius-md;
            background: Theme.canvas-bg;
            border-width: win.focused ? 2px : 1px;
            border-color: win.focused ? win.accent : win.accent.with-alpha(0.35);
            clip: true;

            TouchArea {
                clicked => { root.focus-window(win.window-id); }
            }

            // Header bar
            Rectangle {
                y: 0px;
                height: 40px;
                background: win.focused ? Theme.surface-elevated : Theme.surface-bg;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    spacing: 10px;

                    // Origin chip: who this window really belongs to.
                    Rectangle {
                        horizontal-stretch: 0;
                        min-width: origin-row.min-width;
                        preferred-width: origin-row.preferred-width;
                        Rectangle {
                            y: (parent.height - 24px) / 2;
                            height: 24px;
                            border-radius: 12px;
                            background: win.accent.with-alpha(win.focused ? 0.22 : 0.12);
                            origin-row := HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 10px;
                                spacing: 6px;
                                Rectangle {
                                    width: 7px;
                                    height: 7px;
                                    y: (parent.height - 7px) / 2;
                                    border-radius: 3.5px;
                                    background: win.accent;
                                }
                                Text {
                                    text: win.badge-label;
                                    color: win.focused ? Theme.text-primary : Theme.text-secondary;
                                    font-size: Theme.size-caption;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        text: win.title;
                        color: win.focused ? Theme.text-primary : Theme.text-muted;
                        font-size: Theme.size-body;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    IconButton {
                        icon: "layout-left";
                        button-size: 28px;
                        clicked => { root.snap-window-action(win.window-id, "left-half"); }
                    }
                    IconButton {
                        icon: "layout-quarter";
                        button-size: 28px;
                        clicked => { root.snap-window-action(win.window-id, "top-left"); }
                    }
                    IconButton {
                        icon: "maximize";
                        button-size: 28px;
                        clicked => { root.snap-window-action(win.window-id, "full"); }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.separator;
                }
            }

            // Client surface placeholder (Smithay draws the real Wayland surface here).
            VerticalLayout {
                y: 40px;
                height: parent.height - 40px;
                alignment: center;
                spacing: 6px;
                Text {
                    text: win.title;
                    color: Theme.text-secondary;
                    font-size: Theme.size-title3;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: win.snap-label != "" ? win.badge-label + "  ·  " + win.snap-label : win.badge-label;
                    color: Theme.text-muted;
                    font-size: Theme.size-footnote;
                    horizontal-alignment: center;
                }
            }
        }

        // ================= TOP BAR =================
        Rectangle {
            y: 0px;
            height: root.bar-h;
            background: Theme.bar-glass;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.separator;
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 4px;

                // Search / Action Deck
                Rectangle {
                    horizontal-stretch: 0;
                    min-width: deck-row.min-width;
                    preferred-width: deck-row.preferred-width;
                    Rectangle {
                        y: (parent.height - 26px) / 2;
                        height: 26px;
                        border-radius: 13px;
                        background: root.action-deck-visible ? Theme.accent-soft : deck-ta.has-hover ? Theme.fill-hover : Theme.fill-subtle;
                        deck-row := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 12px;
                            spacing: 7px;
                            Icon {
                                name: "search";
                                size: 14px;
                                color: Theme.text-secondary;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: "Search";
                                color: Theme.text-secondary;
                                font-size: Theme.size-footnote;
                                vertical-alignment: center;
                            }
                        }
                        deck-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-action-deck(); }
                        }
                    }
                }

                Rectangle { width: 6px; }

                // Space switcher
                for pill in root.space-pills : Rectangle {
                    horizontal-stretch: 0;
                    min-width: pill-row.min-width;
                    preferred-width: pill-row.preferred-width;
                    Rectangle {
                        y: (parent.height - 26px) / 2;
                        height: 26px;
                        border-radius: 13px;
                        background: pill.active ? pill.accent.with-alpha(0.20) : pill-ta.has-hover ? Theme.fill-hover : transparent;
                        animate background { duration: 120ms; }
                        pill-row := HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 11px;
                            spacing: 6px;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                y: (parent.height - 7px) / 2;
                                border-radius: 3.5px;
                                background: pill.running ? pill.accent : pill.accent.with-alpha(0.35);
                            }
                            Text {
                                text: pill.name;
                                color: pill.active ? Theme.text-primary : Theme.text-secondary;
                                font-size: Theme.size-footnote;
                                font-weight: pill.active ? 600 : 500;
                                vertical-alignment: center;
                            }
                            if pill.disposable : Icon {
                                name: "hourglass";
                                size: 12px;
                                color: Theme.warning;
                                y: (parent.height - self.height) / 2;
                            }
                            if pill.capturing : Icon {
                                name: "record";
                                size: 12px;
                                color: Theme.danger;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        pill-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.activate-space(pill.vm-id); }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                if !root.vmm-connected : Chip {
                    text: "VM service offline";
                    tone: "danger";
                    dot: true;
                }

                // Memory
                Rectangle {
                    horizontal-stretch: 0;
                    min-width: mem-row.min-width;
                    preferred-width: mem-row.preferred-width;
                    mem-row := HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 8px;
                        Icon {
                            name: "chip";
                            size: 14px;
                            color: Theme.text-secondary;
                            y: (parent.height - self.height) / 2;
                        }
                        Rectangle {
                            width: 44px;
                            Meter {
                                y: (parent.height - self.height) / 2;
                                width: parent.width;
                                ratio: root.host-ram-ratio;
                                fill: root.host-ram-ratio > 0.85 ? Theme.danger : root.host-ram-ratio > 0.65 ? Theme.warning : Theme.accent;
                            }
                        }
                        Text {
                            text: root.host-zram-label;
                            color: Theme.text-muted;
                            font-size: Theme.size-caption;
                            vertical-alignment: center;
                        }
                    }
                }

                IconButton {
                    icon: "bolt";
                    button-size: 28px;
                    clicked => { root.reclaim-ram-clicked(); }
                }
                IconButton {
                    icon: root.wifi-enabled && !root.global-offline-shield ? "wifi" : "wifi-off";
                    tint: root.global-offline-shield ? Theme.warning : Theme.text-secondary;
                    button-size: 28px;
                    clicked => { root.toggle-wifi(); }
                }
                IconButton {
                    icon: root.audio-muted ? "volume-off" : "volume";
                    tint: root.audio-muted ? Theme.danger : Theme.text-secondary;
                    button-size: 28px;
                    clicked => { root.toggle-audio-mute(); }
                }
                HorizontalLayout {
                    spacing: 5px;
                    padding-left: 4px;
                    Icon {
                        name: "battery";
                        size: 15px;
                        color: Theme.text-secondary;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: root.battery-label;
                        color: Theme.text-secondary;
                        font-size: Theme.size-footnote;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ================= DOCK =================
        dock := Rectangle {
            property <length> tile: 46px;
            height: 66px;
            width: dock-row.preferred-width;
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 12px;
            border-radius: 22px;
            background: Theme.surface-glass;
            border-width: 1px;
            border-color: Theme.separator;

            dock-row := HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;

                for pill in root.space-pills : Rectangle {
                    width: dock.tile;
                    Tile {
                        y: 8px;
                        icon: root.net-icon(pill.network-badge);
                        tint: pill.accent;
                        tile-size: dock.tile;
                        badge: pill.disposable ? "hourglass" : "";
                        opacity: pill.running ? 1.0 : 0.55;
                    }
                    if pill.running : Rectangle {
                        y: parent.height - 5px;
                        x: (parent.width - 4px) / 2;
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: pill.active ? Theme.text-primary : Theme.text-muted;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.activate-space(pill.vm-id); }
                    }
                }

                if root.space-pills.length > 0 : Rectangle {
                    width: 1px;
                    Rectangle {
                        y: 16px;
                        height: parent.height - 32px;
                        background: Theme.separator;
                    }
                }

                Rectangle {
                    width: dock.tile;
                    Rectangle {
                        y: 8px;
                        height: dock.tile;
                        border-radius: dock.tile * 0.28;
                        background: new-ta.has-hover ? Theme.fill-pressed : Theme.fill-hover;
                        Icon {
                            name: "plus";
                            size: 22px;
                            color: Theme.text-primary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    new-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.new-space-clicked(); }
                    }
                }
            }
        }

        // ================= NOTICES =================
        if !root.vmm-connected && root.vmm-error != "" : Toast {
            text: root.vmm-error;
            error: true;
            width: Math.min(640px, parent.width - 48px);
            x: (parent.width - self.width) / 2;
            y: root.bar-h + 12px;
        }

        if root.rail-toast != "" : Toast {
            text: root.rail-toast;
            width: Math.min(480px, parent.width - 48px);
            x: (parent.width - self.width) / 2;
            y: root.bar-h + (!root.vmm-connected && root.vmm-error != "" ? 60px : 12px);
        }

        // ================= ACTION DECK (Super) =================
        if root.action-deck-visible : Rectangle {
            background: Theme.scrim;

            TouchArea {
                clicked => { root.toggle-action-deck(); }
            }

            Rectangle {
                width: Math.min(720px, parent.width - 64px);
                height: Math.min(640px, parent.height - 120px);
                x: (parent.width - self.width) / 2;
                y: 84px;
                border-radius: 20px;
                background: Theme.surface-elevated;
                border-width: 1px;
                border-color: Theme.separator;
                clip: true;

                // Swallow clicks inside the deck.
                TouchArea {}

                deck-body := VerticalLayout {
                    padding: 16px;
                    spacing: 14px;

                    Field {
                        icon: "search";
                        placeholder: "Search Spaces, apps and actions";
                        field-font-size: Theme.size-title3;
                        min-height: 48px;
                        text <=> root.deck-query;
                        edited(q) => { root.deck-query-changed(q); }
                    }

                    // Quick start
                    HorizontalLayout {
                        SectionTitle {
                            text: "QUICK START";
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Caption {
                            text: "Disposable";
                            vertical-alignment: center;
                        }
                        Rectangle { width: 8px; }
                        Switch { checked <=> root.deck-launch-disposable; }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        OptionCard {
                            title: "Private browser";
                            description: "Internet only";
                            icon: "globe";
                            tint: Theme.accent;
                            selectable: false;
                            clicked => { root.launch-preset("disposable-browser"); }
                        }
                        OptionCard {
                            title: "Work";
                            description: "Internet only · daily apps";
                            icon: "window";
                            tint: Theme.success;
                            selectable: false;
                            clicked => { root.launch-preset("work-pod"); }
                        }
                        OptionCard {
                            title: "Offline vault";
                            description: "No network at all";
                            icon: "lock";
                            tint: Theme.warning;
                            selectable: false;
                            clicked => { root.launch-preset("offline-vault"); }
                        }
                    }

                    ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                    spacing: 14px;
                    alignment: start;

                    // Selected Space
                    if root.selected-vm-id != "" : VerticalLayout {
                        spacing: 8px;
                        SectionTitle { text: "CURRENT SPACE"; }
                        ListGroup {
                            Rectangle {
                                min-height: 64px;
                                HorizontalLayout {
                                    padding: 12px;
                                    padding-left: 14px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        Tile {
                                            icon: root.net-icon(root.selected-vm-network-badge);
                                            tile-size: 38px;
                                            badge: root.selected-vm-disposable ? "hourglass" : "";
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 4px;
                                        Headline { text: root.selected-vm-name; }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Chip {
                                                text: root.selected-vm-state == "running" ? "Running" : root.selected-vm-state == "paused" ? "Paused" : root.selected-vm-state == "failed" ? "Failed" : "Stopped";
                                                tone: root.selected-vm-state == "running" ? "success" : root.selected-vm-state == "paused" ? "warning" : "neutral";
                                                dot: true;
                                            }
                                            Chip { text: root.selected-vm-network-badge; }
                                            Chip {
                                                text: root.selected-capture-status;
                                                icon: "record";
                                                tone: root.selected-capture-active ? "danger" : "neutral";
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                    IconButton {
                                        icon: "camera";
                                        enabled: root.selected-vm-state == "stopped" && !root.selected-vm-disposable;
                                        clicked => { root.snapshot-vm-action(root.selected-vm-id); }
                                    }
                                    IconButton {
                                        icon: "record";
                                        active: root.selected-capture-active;
                                        tint: root.selected-capture-active ? Theme.danger : Theme.text-secondary;
                                        enabled: root.selected-capture-active || (root.selected-vm-state == "running" && root.selected-capture-supported);
                                        clicked => {
                                            if (root.selected-capture-active) {
                                                root.stop-capture-action(root.selected-vm-id);
                                            } else {
                                                root.start-capture-action(root.selected-vm-id);
                                            }
                                        }
                                    }
                                    if root.selected-vm-state == "running" || root.selected-vm-state == "paused" : PushButton {
                                        text: "Stop";
                                        icon: "power";
                                        kind: "danger";
                                        clicked => {
                                            root.confirm-stop-vm-id = root.selected-vm-id;
                                            root.confirm-stop-vm-name = root.selected-vm-name;
                                            root.confirm-stop-vm-disposable = root.selected-vm-disposable;
                                            root.confirm-stop-visible = true;
                                        }
                                    }
                                    if root.selected-vm-state != "running" : PushButton {
                                        text: "Start";
                                        icon: "play";
                                        kind: "primary";
                                        clicked => { root.start-vm-action(root.selected-vm-id); }
                                    }
                                }
                                if root.selected-snapshots.length + root.selected-captures.length > 0 : Rectangle {
                                    x: 14px;
                                    y: parent.height - 1px;
                                    width: parent.width - 14px;
                                    height: 1px;
                                    background: Theme.separator;
                                }
                            }
                            for snap[si] in root.selected-snapshots : ListRow {
                                title: "Snapshot " + snap.short-id;
                                subtitle: snap.created-at;
                                icon: "camera";
                                icon-tint: Theme.info;
                                last: si == root.selected-snapshots.length - 1 && root.selected-captures.length == 0;
                                PushButton {
                                    text: "Restore";
                                    icon: "restore";
                                    small: true;
                                    enabled: snap.can-restore;
                                    clicked => {
                                        root.confirm-restore-vm-id = snap.vm-id;
                                        root.confirm-restore-vm-name = root.selected-vm-name;
                                        root.confirm-restore-snap-id = snap.snapshot-id;
                                        root.confirm-restore-short-id = snap.short-id;
                                        root.confirm-restore-visible = true;
                                    }
                                }
                                IconButton {
                                    icon: "trash";
                                    tint: Theme.danger;
                                    clicked => { root.delete-snapshot-action(snap.vm-id, snap.snapshot-id); }
                                }
                            }
                            for cap[ci] in root.selected-captures : ListRow {
                                title: "Capture " + cap.short-id;
                                subtitle: cap.started-at + "  ·  " + cap.bytes-label;
                                icon: "record";
                                icon-tint: cap.state == "running" ? Theme.danger : Theme.text-muted;
                                last: ci == root.selected-captures.length - 1;
                                Chip {
                                    text: cap.state == "running" ? "Recording" : cap.state == "limit_reached" ? "Size limit" : "Saved";
                                    tone: cap.state == "running" ? "danger" : cap.state == "limit_reached" ? "warning" : "success";
                                    dot: true;
                                }
                                IconButton {
                                    icon: "trash";
                                    tint: Theme.danger;
                                    enabled: cap.state != "running";
                                    clicked => { root.delete-capture-action(cap.vm-id, cap.capture-id); }
                                }
                            }
                        }
                    }

                    // Results
                    if root.deck-results.length > 0 : VerticalLayout {
                        spacing: 8px;
                        SectionTitle { text: "RESULTS"; }
                        ListGroup {
                            for item[ri] in root.deck-results : Rectangle {
                                min-height: 52px;
                                background: res-ta.has-hover ? Theme.fill-hover : transparent;
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 30px;
                                            height: 30px;
                                            border-radius: 8px;
                                            background: item.accent.with-alpha(0.18);
                                            Rectangle {
                                                width: 8px;
                                                height: 8px;
                                                x: 11px;
                                                y: 11px;
                                                border-radius: 4px;
                                                background: item.accent;
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 1px;
                                        Text {
                                            text: item.title;
                                            color: Theme.text-primary;
                                            font-size: Theme.size-body;
                                            font-weight: 500;
                                        }
                                        Text {
                                            text: item.subtitle;
                                            color: Theme.text-muted;
                                            font-size: Theme.size-footnote;
                                        }
                                    }
                                    Text {
                                        text: item.category;
                                        color: Theme.text-muted;
                                        font-size: Theme.size-caption;
                                        vertical-alignment: center;
                                    }
                                    Icon {
                                        name: "chevron-right";
                                        size: 14px;
                                        color: Theme.text-muted;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                                if ri < root.deck-results.length - 1 : Rectangle {
                                    x: 56px;
                                    y: parent.height - 1px;
                                    width: parent.width - 56px;
                                    height: 1px;
                                    background: Theme.separator;
                                }
                                res-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.activate-deck-entry(item.entry-id); }
                                }
                            }
                        }
                    }

                    }
                    }

                    // Quick controls
                    HorizontalLayout {
                        spacing: 8px;
                        PushButton {
                            text: root.wifi-enabled ? "Wi-Fi on" : "Wi-Fi off";
                            icon: root.wifi-enabled ? "wifi" : "wifi-off";
                            small: true;
                            clicked => { root.toggle-wifi(); }
                        }
                        PushButton {
                            text: root.audio-muted ? "Muted" : "Sound on";
                            icon: root.audio-muted ? "volume-off" : "volume";
                            small: true;
                            clicked => { root.toggle-audio-mute(); }
                        }
                        PushButton {
                            text: "Scale " + root.display-scale-pct + "%";
                            icon: "monitor";
                            small: true;
                            clicked => { root.cycle-display-scale(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        PushButton {
                            text: root.global-offline-shield ? "Offline shield on" : "Offline shield";
                            icon: "shield";
                            small: true;
                            kind: root.global-offline-shield ? "primary" : "secondary";
                            clicked => { root.toggle-offline-shield(); }
                        }
                    }
                }
            }
        }

        // ================= SHEETS =================
        if root.confirm-stop-visible : Sheet {
            title: "Stop “" + root.confirm-stop-vm-name + "”?";
            message: "This switches the Space off immediately, like pulling the plug. Anything unsaved inside it may be lost.";
            note: root.confirm-stop-vm-disposable ? "This Space is disposable: every change since it started will be erased." : "";
            icon: "power";
            tone: "danger";
            confirm-text: "Stop Space";
            confirm-kind: "danger-solid";
            cancelled => { root.confirm-stop-visible = false; }
            confirmed => {
                root.confirm-stop-visible = false;
                root.confirm-stop-vm-action(root.confirm-stop-vm-id);
            }
        }

        if root.confirm-restore-visible : Sheet {
            title: "Restore snapshot " + root.confirm-restore-short-id + "?";
            message: "“" + root.confirm-restore-vm-name + "” goes back to how it was when this snapshot was taken. Changes made since then are lost.";
            icon: "restore";
            tone: "warning";
            confirm-text: "Restore";
            confirm-kind: "primary";
            cancelled => { root.confirm-restore-visible = false; }
            confirmed => {
                root.confirm-restore-visible = false;
                root.confirm-restore-snapshot-action(root.confirm-restore-vm-id, root.confirm-restore-snap-id);
            }
        }
    }
}
